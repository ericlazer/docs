            "pages": [
              "02-how-nexio-works/0.system-architecture",
              "02-how-nexio-works/1.borrower-overview",
              "02-how-nexio-works/2.lender-overview",
              "02-how-nexio-works/3.borrower-lender-faq"
            ]
          },
          {
            "group": "Strategies & Yield Sources",
            "pages": [
              "03-strategies-and-yield-sources/1.strategy-overview",
              "03-strategies-and-yield-sources/2.cme-basis",
              "03-strategies-and-yield-sources/3.delta-neutral",
              "03-strategies-and-yield-sources/4.market-making"
            ]
          },
          {
            "group": "Risk & Governance",
            "pages": [
              "04-risk-and-governance/1.Credit-Scoring",
              "04-risk-and-governance/2.Concentration-Limits",
              "04-risk-and-governance/3.Covenant-Monitoring"
            ]
