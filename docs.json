          {
            "group": "Security, Custody & Compliance",
            "pages": [
              "05-Security-Custody-Compliance/1.Bitcoin-Custody",
              "05-Security-Custody-Compliance/2.Compliance-Controls",
              "05-Security-Custody-Compliance/3.Auditability-and-Legal"
