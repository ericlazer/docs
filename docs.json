{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Nexio Docs",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.nexio.xyz/"
  },
  "colors": {
    "primary": "#1A45ED",
    "light": "#1A45ED",
    "dark": "#0A0F29"
  },
  "background": {
